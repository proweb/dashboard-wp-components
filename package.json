{
	"name": "wp-components-dashboard",
	"version": "0.1.0",
	"description": "WordPress Gutenberg components in wp-admin",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"server": "npx @wp-playground/cli server --auto-mount --login",
		"watch": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "concurrently \"npm run server\" \"npm run watch\""
	},
	"devDependencies": {
		"@wordpress/scripts": "^32.4.1",
		"concurrently": "^10.0.3"
	},
	"dependencies": {
		"@wordpress/admin-ui": "^2.3.1",
		"@wordpress/api-fetch": "^7.48.1",
		"@wordpress/components": "^35.0.1",
		"@wordpress/data": "^10.48.1",
		"@wordpress/dataviews": "^16.0.1",
		"@wordpress/element": "^8.0.1",
		"@wordpress/i18n": "^6.21.1",
		"@wordpress/icons": "^14.0.1",
		"@wordpress/notices": "^5.48.1",
		"@wordpress/ui": "^0.15.1"
	}
}
