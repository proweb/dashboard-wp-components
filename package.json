{
	"name": "wp-components-dashboard",
	"version": "0.1.0",
	"description": "WordPress Gutenberg components in wp-admin",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"server": "npx @wp-playground/cli server --auto-mount --login",
		"watch": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "concurrently \"npm run server\" \"npm run watch\""
	},
	"devDependencies": {
		"@wordpress/scripts": "^36.0.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"dependencies": {
		"@10up/block-components": "^1.22.4",
		"@wordpress/admin-ui": "^2.11.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/dataviews": "^19.1.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/notices": "^5.56.0",
		"@wordpress/ui": "^0.23.0",
		"ajv": "^8.20.0",
		"typescript": "^5.8.2"
	}
}
