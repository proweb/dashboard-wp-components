{
	"name": "wp-components-dashboard",
	"version": "0.1.0",
	"description": "WordPress Gutenberg components in wp-admin",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"server": "npx @wp-playground/cli server --auto-mount --login",
		"watch": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "concurrently \"npm run server\" \"npm run watch\""
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.0.0",
		"concurrently": "^10.0.6",
		"eslint": "^10.14.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"dependencies": {
		"@10up/block-components": "^1.23.0",
		"@wordpress/admin-ui": "^3.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dataviews": "^21.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/ui": "^0.25.0",
		"ajv": "^8.20.0",
		"typescript": "^6.0.3"
	}
}
